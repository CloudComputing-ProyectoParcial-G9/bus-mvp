# Data Ingestion Environment Variables
# Copy this file to .env and configure your specific values

# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
ENVIRONMENT=development
INGESTION_LOG_LEVEL=INFO
DEBUG=false

# ========================================
# DATABASE CONNECTIONS
# ========================================

# PostgreSQL (ms-passengers) - matches infra/.env
SQL1_HOST=localhost
SQL1_PORT=5431
SQL1_DB=passengers_db
SQL1_USER=passengers_user
SQL1_PASSWORD=change_me_sql1_password

# MySQL (ms-trips) - matches infra/.env  
SQL2_HOST=localhost
SQL2_PORT=3306
SQL2_DB=trips_db
SQL2_USER=trips_user
SQL2_PASSWORD=change_me_sql2_password

# MongoDB (ms-tickets) - matches infra/.env
NOSQL_HOST=localhost
NOSQL_PORT=27017
NOSQL_DB=tickets_db
NOSQL_USER=tickets_user
NOSQL_PASSWORD=change_me_nosql_password
NOSQL_URL=mongodb://localhost:27017

# ========================================
# INGESTION SETTINGS
# ========================================

# General settings
EXTRACTION_INTERVAL=300
BATCH_SIZE=1000
MAX_RETRIES=3

# PostgreSQL specific
CDC_ENABLED=true
FULL_SYNC_HOUR=2

# MySQL specific  
BINLOG_ENABLED=true
ROUTES_SYNC_INTERVAL=3600

# MongoDB specific
CHANGE_STREAMS=true
FULL_SYNC_INTERVAL=86400

# ========================================
# OBJECT STORAGE - AWS S3 ONLY
# ========================================

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=bus-mvp-data-lake

# ========================================
# CACHING
# ========================================

# Redis
REDIS_PASSWORD=defaultpassword

# ========================================
# ANALYTICS INTEGRATION
# ========================================

# Analytics service
MS_ANALYTICS_PORT=8010
ANALYTICS_API_KEY=analytics_api_key

# ========================================
# MONITORING
# ========================================

# Health checks
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true

# Prometheus (optional)
PROMETHEUS_ENABLED=false
