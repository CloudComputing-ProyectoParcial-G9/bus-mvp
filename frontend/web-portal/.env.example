# Variables de Entorno - Frontend SPA
# ==========================================
#
# Copiar este archivo a .env para desarrollo local
# Ajustar URLs según configuración del Load Balancer
#
# TODO (@F): Completar con variables específicas del framework elegido

# ==========================================
# CONFIGURACIÓN API
# ==========================================

# URL base del Load Balancer (PRODUCCIÓN - Futuro)
VITE_API_BASE_URL=http://localhost:8080

# URLs directas de microservicios (DESARROLLO)
# Estas son las variables que el código de api.ts está usando
VITE_PASSENGERS_API=http://localhost:8001
VITE_TRIPS_API=http://localhost:8002
VITE_TICKETS_API=http://localhost:8003
VITE_HISTORY_API=http://localhost:8004
VITE_ANALYTICS_API=http://localhost:8005

# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================

# Información básica
VITE_APP_NAME="Bus MVP Portal"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Sistema de gestión de boletos de autobús"

# Entorno de ejecución
NODE_ENV=development
VITE_ENVIRONMENT=development

# Puerto de desarrollo
PORT=3000
VITE_PORT=3000

# ==========================================
# CONFIGURACIÓN DE AUTENTICACIÓN
# ==========================================

# JWT Configuration (si se implementa)
VITE_JWT_SECRET=your_jwt_secret_here_min_32_chars
VITE_JWT_EXPIRES_IN=3600000
VITE_REFRESH_TOKEN_EXPIRES_IN=604800000

# Session timeout (milisegundos)
VITE_SESSION_TIMEOUT=1800000
VITE_SESSION_WARNING_TIME=300000

# ==========================================
# CONFIGURACIÓN DE LOGS Y DEBUGGING
# ==========================================

# Nivel de logging
VITE_LOG_LEVEL=info
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_NETWORK_LOGS=true

# Debug mode
VITE_DEBUG_MODE=true
VITE_SHOW_API_RESPONSES=true

# ==========================================
# CONFIGURACIÓN UI/UX
# ==========================================

# Tema predeterminado
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true

# Idioma predeterminado
VITE_DEFAULT_LOCALE=es
VITE_ENABLE_I18N=true

# Paginación
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# ==========================================
# CONFIGURACIÓN DE PERFORMANCE
# ==========================================

# Timeout para requests HTTP (milisegundos)
VITE_HTTP_TIMEOUT=10000
VITE_RETRY_ATTEMPTS=3
VITE_RETRY_DELAY=1000

# Cache configuration
VITE_ENABLE_CACHE=true
VITE_CACHE_DURATION=300000

# Service Worker
VITE_ENABLE_SERVICE_WORKER=false
VITE_CACHE_STRATEGY=networkFirst

# ==========================================
# CONFIGURACIÓN DE ANALYTICS
# ==========================================

# Habilitar analytics
VITE_ENABLE_ANALYTICS=true
VITE_ANALYTICS_ENDPOINT=/api/analytics

# Google Analytics (opcional)
VITE_GA_TRACKING_ID=
VITE_GA_MEASUREMENT_ID=

# ==========================================
# CONFIGURACIÓN DE MAPAS (opcional)
# ==========================================

# Para mostrar rutas de autobús
VITE_MAPS_API_KEY=
VITE_MAPS_PROVIDER=google
VITE_DEFAULT_MAP_CENTER_LAT=19.432608
VITE_DEFAULT_MAP_CENTER_LNG=-99.133209
VITE_DEFAULT_MAP_ZOOM=10

# ==========================================
# CONFIGURACIÓN DE NOTIFICACIONES
# ==========================================

# Push notifications
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_VAPID_PUBLIC_KEY=

# Email notifications
VITE_ENABLE_EMAIL_NOTIFICATIONS=true
VITE_SUPPORT_EMAIL=support@busmvp.com

# ==========================================
# CONFIGURACIÓN DE PAGOS (opcional)
# ==========================================

# Payment gateway
VITE_PAYMENT_PROVIDER=stripe
VITE_STRIPE_PUBLIC_KEY=
VITE_PAYPAL_CLIENT_ID=

# Currency
VITE_DEFAULT_CURRENCY=MXN
VITE_CURRENCY_SYMBOL=$

# ==========================================
# CONFIGURACIÓN DE DESARROLLO
# ==========================================

# Hot reload
FAST_REFRESH=true
VITE_ENABLE_HMR=true

# Source maps
GENERATE_SOURCEMAP=true
VITE_SOURCE_MAP=true

# Bundle analyzer
VITE_BUNDLE_ANALYZER=false

# ==========================================
# CONFIGURACIÓN DE TESTS
# ==========================================

# Testing environment
VITE_TEST_API_URL=http://localhost:8080
VITE_ENABLE_TEST_MODE=false

# Mock data
VITE_USE_MOCK_DATA=false
VITE_MOCK_DELAY=500

# ==========================================
# CONFIGURACIÓN DE SEGURIDAD
# ==========================================

# CORS
VITE_ENABLE_CORS=true
VITE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Content Security Policy
VITE_CSP_ENABLED=false

# XSS Protection
VITE_ENABLE_XSS_PROTECTION=true

# ==========================================
# CONFIGURACIÓN DE FRAMEWORK ESPECÍFICO
# ==========================================

# React específico
REACT_APP_ENABLE_PROFILER=false
REACT_APP_STRICT_MODE=true

# Vue específico
VUE_APP_MODE=development
VUE_APP_DEVTOOLS=true

# Angular específico
NG_APP_ENV=development
NG_APP_PRODUCTION=false

# Next.js específico
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# CONFIGURACIÓN DE BUILD
# ==========================================

# Build optimization
VITE_BUILD_MINIFY=terser
VITE_BUILD_TARGET=es2020
VITE_BUILD_SOURCEMAP=true

# Output directory
VITE_OUT_DIR=dist
VITE_ASSETS_DIR=assets

# Public path
VITE_BASE_PATH=/
VITE_PUBLIC_PATH=/

# ==========================================
# CONFIGURACIÓN DE DOCKER
# ==========================================

# Imagen base
DOCKER_NODE_VERSION=18-alpine
DOCKER_NGINX_VERSION=1.25-alpine

# Ports
DOCKER_CONTAINER_PORT=3000
DOCKER_HOST_PORT=3000

# ==========================================
# CONFIGURACIÓN DE MONITOREO
# ==========================================

# Health check
VITE_HEALTH_CHECK_ENDPOINT=/health
VITE_HEALTH_CHECK_INTERVAL=30000

# Performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_PERFORMANCE_ENDPOINT=/metrics

# Error tracking
VITE_ENABLE_ERROR_TRACKING=true
VITE_ERROR_TRACKING_ENDPOINT=/errors

# ==========================================
# NOTAS IMPORTANTES
# ==========================================

# 1. Variables con prefijo VITE_ son accesibles en el cliente
# 2. Variables REACT_APP_ solo funcionan con Create React App
# 3. Variables VUE_APP_ solo funcionan con Vue CLI
# 4. Variables NEXT_PUBLIC_ son públicas en Next.js
# 5. NO incluir secretos o claves privadas en variables públicas
# 6. Usar diferentes archivos .env para diferentes entornos:
#    - .env.local (desarrollo local)
#    - .env.development (desarrollo)
#    - .env.staging (staging)
#    - .env.production (producción)
