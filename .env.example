# ========================================
# Bus MVP - Variables de Entorno Backend
# ========================================
# Configuración centralizada para todos los microservicios del backend
# INSTRUCCIONES: Copiar este archivo como .env y ajustar valores según el entorno

# ========================================
# CONFIGURACIÓN GENERAL
# ========================================
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info
PROJECT_VERSION=1.0.0

# ========================================
# PUERTOS DE SERVICIOS
# ========================================
MS_PASSENGERS_PORT=8001
MS_TRIPS_PORT=8002
MS_TICKETS_PORT=8003
MS_HISTORY_PORT=8004
MS_ANALYTICS_PORT=8005

# ========================================
# BASE DE DATOS - MySQL (ms-trips)
# ========================================
# Configuración de MySQL para ms-trips
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=trips_db
MYSQL_DB=trips_db
MYSQL_USER=trips_user
MYSQL_PASSWORD=secure_password
MYSQL_HOST=mysql-trips
MYSQL_PORT=3306

# Variables alternativas SQL2 (mismo servicio)
SQL2_HOST=mysql-trips
SQL2_PORT=3306
SQL2_DB=trips_db
SQL2_USER=trips_user
SQL2_PASSWORD=secure_password

# ========================================
# BASE DE DATOS - PostgreSQL (ms-passengers)
# ========================================
# Configuración de PostgreSQL para ms-passengers
POSTGRES_DB=passengers_db
POSTGRES_USER=passengers_user
POSTGRES_PASSWORD=passengers_password
POSTGRES_HOST=postgres-passengers
POSTGRES_PORT=5432

# Variables alternativas SQL1 (mismo servicio)
SQL1_HOST=postgres-passengers
SQL1_PORT=5432
SQL1_DB=passengers_db
SQL1_USER=passengers_user
SQL1_PASSWORD=passengers_password

# Database URL completa para ms-passengers
DATABASE_URL=postgresql://passengers_user:passengers_password@postgres-passengers:5432/passengers_db

# ========================================
# BASE DE DATOS - MongoDB (ms-tickets)
# ========================================
# Configuración de MongoDB para ms-tickets
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpassword
MONGO_INITDB_DATABASE=tickets_db
MONGO_HOST=mongo-tickets
MONGO_PORT=27017

# Variables NoSQL alternativas
NOSQL_HOST=mongo-tickets
NOSQL_PORT=27017
NOSQL_DB=tickets_db
NOSQL_USER=tickets_user
NOSQL_PASSWORD=tickets_password

# MongoDB URI para ms-tickets
SPRING_DATA_MONGODB_URI=mongodb://tickets_user:tickets_password@mongo-tickets:27017/tickets_db

# ========================================
# CONFIGURACIÓN ms-trips (Node.js)
# ========================================
PROJECT_NAME=Bus MVP - Trips Service
API_V1_PREFIX=/api/v1
LOG_FORMAT=combined

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# Health Check
HEALTH_CHECK_TIMEOUT_MS=5000

# ========================================
# CONFIGURACIÓN ms-tickets (Java/Spring)
# ========================================
SPRING_PROFILES_ACTIVE=development
IDEMPOTENCY_TTL_SECONDS=3600

# Integración con otros servicios
ENABLE_INTEGRATION_CHECKS=false

# ========================================
# CONFIGURACIÓN ms-history (Go)
# ========================================
# URLs de microservicios para ms-history
MS_PASSENGERS_URL=http://ms-passengers:8001
MS_TRIPS_URL=http://ms-trips:8002
MS_TICKETS_URL=http://ms-tickets:8003

# Timeouts y reintentos
HTTP_TIMEOUT_MS=5000
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60000

# Cache (Redis - opcional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis_pass_2024
CACHE_TTL_SECONDS=300
ENABLE_CACHE=false

# ========================================
# CONFIGURACIÓN ms-analytics (Python)
# ========================================
APP_NAME=Bus MVP Analytics API
APP_VERSION=1.0.0
DEBUG=True

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_SESSION_TOKEN=your_session_token
AWS_DEFAULT_REGION=us-east-1

# Athena Configuration
GLUE_DATABASE=bus_mvp_db
ATHENA_OUTPUT_LOCATION=s3://bus-mvp-datalake-1/athena-results/
ATHENA_QUERY_TIMEOUT=60

# CORS para Analytics
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# ========================================
# CONFIGURACIÓN FRONTEND (Web Portal)
# ========================================
# URLs de microservicios para el frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_PASSENGERS_API=http://localhost:8001
VITE_TRIPS_API=http://localhost:8002
VITE_TICKETS_API=http://localhost:8003
VITE_HISTORY_API=http://localhost:8004
VITE_ANALYTICS_API=http://localhost:8005

# Frontend Configuration
VITE_APP_NAME=Bus MVP Portal
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
VITE_LOG_LEVEL=info

# ========================================
# CONFIGURACIÓN DE PUERTOS EXTERNOS
# ========================================
# Puertos expuestos en el host para las bases de datos
MYSQL_EXTERNAL_PORT=3307
POSTGRES_EXTERNAL_PORT=5433
MONGO_EXTERNAL_PORT=27018

# ========================================
# HEALTHCHECK CONFIGURATION
# ========================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=5

# ========================================
# PUERTOS DE SERVICIOS
# ========================================
MS_PASSENGERS_PORT=8001
MS_TRIPS_PORT=8002
MS_TICKETS_PORT=8003
MS_HISTORY_PORT=8004
MS_ANALYTICS_PORT=8005
LB_PORT=8080

# ========================================
# BASE DE DATOS SQL 1 (PostgreSQL - ms-passengers)
# ========================================
SQL1_DB=passengers_db
SQL1_USER=passengers_user
SQL1_PASSWORD=passengers_pass_2024
SQL1_PORT=5432

# ========================================
# BASE DE DATOS SQL 2 (MySQL - ms-trips)
# ========================================
SQL2_DB=trips_db
SQL2_USER=trips_user
SQL2_PASSWORD=trips_pass_2024
SQL2_PORT=3306

# ========================================
# BASE DE DATOS NoSQL (MongoDB - ms-tickets)
# ========================================
NOSQL_DB=tickets_db
NOSQL_USER=tickets_user
NOSQL_PASSWORD=tickets_pass_2024

# ========================================
# CONFIGURACIÓN ms-history
# ========================================
HTTP_TIMEOUT_MS=5000
MAX_RETRIES=3
RETRY_DELAY_MS=1000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60000

# ========================================
# CONFIGURACIÓN ms-analytics
# ========================================
CLOUD_REGION=us-east-1
OBJECT_STORE_BUCKET=bus-mvp-analytics-bucket
QUERY_OUTPUT_PATH=s3://bus-mvp-analytics-bucket/query-results/
CATALOG_DATABASE=bus_mvp_catalog
QUERY_TIMEOUT_SECONDS=300

# AWS (opcional - solo si se usa AWS)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# GCP (opcional - solo si se usa GCP)
# GCP_PROJECT_ID=your_gcp_project_id

# Azure (opcional - solo si se usa Azure)
# AZURE_TENANT_ID=your_azure_tenant_id

# ========================================
# SERVICIOS OPCIONALES
# ========================================

# Redis Cache
REDIS_PASSWORD=redis_pass_2024

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin123

# ========================================
# CONFIGURACIÓN DE DESARROLLO
# ========================================

# Para desarrollo local, usar estas URLs
DEV_MS_PASSENGERS_URL=http://localhost:8001
DEV_MS_TRIPS_URL=http://localhost:8002
DEV_MS_TICKETS_URL=http://localhost:8003
DEV_MS_HISTORY_URL=http://localhost:8004
DEV_MS_ANALYTICS_URL=http://localhost:8005

# ========================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ========================================

# Para producción, usar nombres de servicio de Docker
PROD_MS_PASSENGERS_URL=http://ms-passengers:8001
PROD_MS_TRIPS_URL=http://ms-trips:8002
PROD_MS_TICKETS_URL=http://ms-tickets:8003
PROD_MS_HISTORY_URL=http://ms-history:8004
PROD_MS_ANALYTICS_URL=http://ms-analytics:8005

# ========================================
# SEGURIDAD
# ========================================

# JWT Secrets (generar claves únicas para producción)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Encryption keys
ENCRYPTION_KEY=your_32_character_encryption_key_here

# CORS origins (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# OBSERVABILIDAD
# ========================================

# Tracing
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
ENABLE_TRACING=false

# Metrics
PROMETHEUS_ENDPOINT=http://prometheus:9090
ENABLE_METRICS=false

# ========================================
# CONFIGURACIÓN DE CACHE
# ========================================
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# ========================================
# CONFIGURACIÓN DE HEALTHCHECKS
# ========================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3