# ========================================
# Bus MVP - Variables de Entorno
# ========================================
# Configuración completa para todos los servicios del Bus MVP
# Copiar este archivo como .env y ajustar valores según el entorno

# ========================================
# CONFIGURACIÓN GENERAL
# ========================================
NODE_ENV=development
LOG_LEVEL=info
ENVIRONMENT=local

# ========================================
# PUERTOS DE SERVICIOS
# ========================================
MS_PASSENGERS_PORT=8001
MS_TRIPS_PORT=8002
MS_TICKETS_PORT=8003
MS_HISTORY_PORT=8004
MS_ANALYTICS_PORT=8005
LB_PORT=8080

# ========================================
# BASE DE DATOS SQL 1 (PostgreSQL - ms-passengers)
# ========================================
SQL1_DB=passengers_db
SQL1_USER=passengers_user
SQL1_PASSWORD=passengers_pass_2024
SQL1_PORT=5432

# ========================================
# BASE DE DATOS SQL 2 (MySQL - ms-trips)
# ========================================
SQL2_DB=trips_db
SQL2_USER=trips_user
SQL2_PASSWORD=trips_pass_2024
SQL2_PORT=3306

# ========================================
# BASE DE DATOS NoSQL (MongoDB - ms-tickets)
# ========================================
NOSQL_DB=tickets_db
NOSQL_USER=tickets_user
NOSQL_PASSWORD=tickets_pass_2024

# ========================================
# CONFIGURACIÓN ms-history
# ========================================
HTTP_TIMEOUT_MS=5000
MAX_RETRIES=3
RETRY_DELAY_MS=1000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60000

# ========================================
# CONFIGURACIÓN ms-analytics
# ========================================
CLOUD_REGION=us-east-1
OBJECT_STORE_BUCKET=bus-mvp-analytics-bucket
QUERY_OUTPUT_PATH=s3://bus-mvp-analytics-bucket/query-results/
CATALOG_DATABASE=bus_mvp_catalog
QUERY_TIMEOUT_SECONDS=300

# AWS (opcional - solo si se usa AWS)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# GCP (opcional - solo si se usa GCP)
# GCP_PROJECT_ID=your_gcp_project_id

# Azure (opcional - solo si se usa Azure)
# AZURE_TENANT_ID=your_azure_tenant_id

# ========================================
# SERVICIOS OPCIONALES
# ========================================

# Redis Cache
REDIS_PASSWORD=redis_pass_2024

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin123

# ========================================
# CONFIGURACIÓN DE DESARROLLO
# ========================================

# Para desarrollo local, usar estas URLs
DEV_MS_PASSENGERS_URL=http://localhost:8001
DEV_MS_TRIPS_URL=http://localhost:8002
DEV_MS_TICKETS_URL=http://localhost:8003
DEV_MS_HISTORY_URL=http://localhost:8004
DEV_MS_ANALYTICS_URL=http://localhost:8005

# ========================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ========================================

# Para producción, usar nombres de servicio de Docker
PROD_MS_PASSENGERS_URL=http://ms-passengers:8001
PROD_MS_TRIPS_URL=http://ms-trips:8002
PROD_MS_TICKETS_URL=http://ms-tickets:8003
PROD_MS_HISTORY_URL=http://ms-history:8004
PROD_MS_ANALYTICS_URL=http://ms-analytics:8005

# ========================================
# SEGURIDAD
# ========================================

# JWT Secrets (generar claves únicas para producción)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Encryption keys
ENCRYPTION_KEY=your_32_character_encryption_key_here

# CORS origins (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# OBSERVABILIDAD
# ========================================

# Tracing
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
ENABLE_TRACING=false

# Metrics
PROMETHEUS_ENDPOINT=http://prometheus:9090
ENABLE_METRICS=false

# ========================================
# CONFIGURACIÓN DE CACHE
# ========================================
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# ========================================
# CONFIGURACIÓN DE HEALTHCHECKS
# ========================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3