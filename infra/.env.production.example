# .env.production.example - Variables sensibles para producción
# Copiar como .env.production y completarlas en la VM o generarlas desde Secrets Manager

# ECR / images
ECR_ACCOUNT_ID=<YOUR_AWS_ACCOUNT_ID>
ECR_REGION=us-east-1
ECR_REPO_MS_PASSENGERS=bus-mvp-ms-passengers
ECR_TAG=latest

# Postgres (recomendado usar RDS y apuntar con HOST/RDS endpoint)
SQL1_HOST=<rds-endpoint-or-hostname>
SQL1_PORT=5432
SQL1_DB=passengers_db
SQL1_USER=passengers_user
SQL1_PASSWORD=<strong_password_here>

# Puertos y LB
MS_PASSENGERS_PORT=8001
LB_PORT=8088

# Otros ajustes
LOG_LEVEL=info
ENVIRONMENT=production

# NOTA: Para seguridad, NO comites este archivo con credenciales reales.
