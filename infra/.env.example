# ===============================
# VARIABLES DE ENTORNO - EJEMPLO
# ===============================
# 
# Copiar este archivo como .env y completar con valores reales
# cp .env.example .env
#
# IMPORTANTE: NO SUBIR .env al repositorio (está en .gitignore)

# ===============================
# BASES DE DATOS SQL
# ===============================

# SQL Database 1 (para ms-passengers)
# TODO: Elegir motor SQL (PostgreSQL, MySQL, SQL Server)
SQL1_HOST=localhost
SQL1_PORT=5431
SQL1_DB=passengers_db
SQL1_USER=passengers_user
SQL1_PASSWORD=change_me_sql1_password

# SQL Database 2 (para ms-trips) 
# TODO: Elegir motor SQL diferente al anterior
SQL2_HOST=localhost
SQL2_PORT=3306
SQL2_DB=trips_db
SQL2_USER=trips_user
SQL2_PASSWORD=change_me_sql2_password

# ===============================
# BASE DE DATOS NOSQL
# ===============================

# NoSQL Database (para ms-tickets)
# TODO: Elegir motor NoSQL (MongoDB, CouchDB, etc.)
NOSQL_URL=mongodb://localhost:27017
NOSQL_DB=tickets_db
NOSQL_USER=tickets_user
NOSQL_PASSWORD=change_me_nosql_password

# ===============================
# PUERTOS DE MICROSERVICIOS
# ===============================

MS_PASSENGERS_PORT=8001
MS_TRIPS_PORT=8002
MS_TICKETS_PORT=8003
MS_HISTORY_PORT=8004
MS_ANALYTICS_PORT=8010

# Puerto del Load Balancer
LB_PORT=8088

# ===============================
# CONFIGURACION DE NUBE / ANALYTICS
# ===============================

# Region del proveedor cloud
CLOUD_REGION=us-east-1

# Object Storage (S3/GCS/Blob Storage)
OBJECT_STORE_BUCKET=bus-mvp-data-lake

# Rutas dentro del bucket
DATA_LOCATION_PREFIX=raw/
QUERY_OUTPUT_PATH=results/query-outputs/

# Data Catalog (Glue/Data Catalog/Purview)
CATALOG_DATABASE=bus_mvp_catalog

# Query Engine (Athena/BigQuery/Synapse)
QUERY_ENGINE_WORKGROUP=bus-mvp-analytics
QUERY_TIMEOUT_SECONDS=300

# ===============================
# VARIABLES ESPECÍFICAS POR PROVEEDOR CLOUD
# ===============================

# ----------- AWS -----------
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_GLUE_CATALOG_DATABASE=bus_mvp_catalog
# AWS_ATHENA_WORKGROUP=bus-mvp-analytics
# AWS_S3_BUCKET=bus-mvp-data-lake

# ----------- Google Cloud -----------
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=bus-mvp-project
# GCP_DATASET_ID=bus_mvp_catalog
# GCP_BUCKET=bus-mvp-data-lake
# BIGQUERY_LOCATION=US

# ----------- Azure -----------
# AZURE_TENANT_ID=your_tenant_id
# AZURE_CLIENT_ID=your_client_id
# AZURE_CLIENT_SECRET=your_client_secret
# AZURE_STORAGE_ACCOUNT=busmvpdatalake
# AZURE_CONTAINER=raw-data
# AZURE_SYNAPSE_WORKSPACE=bus-mvp-analytics

# ===============================
# FRONTEND
# ===============================

FRONTEND_PORT=5173

# URLs de los microservicios desde el frontend
# (En producción, usar URLs del load balancer)
API_BASE_URL=http://localhost:8088/api

# ===============================
# CONFIGURACIÓN DE DESARROLLO
# ===============================

# Modo de ejecución
NODE_ENV=development
ENVIRONMENT=local

# Logging
LOG_LEVEL=info

# Timeouts HTTP (en millisegundos)
HTTP_TIMEOUT_MS=5000
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# ===============================
# CACHE (OPCIONAL)
# ===============================

# Redis para cache (opcional)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ===============================
# SEGURIDAD
# ===============================

# JWT Secret (si se implementa autenticación)
# JWT_SECRET=your_super_secret_jwt_key

# API Keys (si se requieren)
# API_KEY_ANALYTICS=your_analytics_api_key

# CORS Origins (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===============================
# TESTING
# ===============================

# Base de datos para tests
TEST_SQL1_URL=sqlite:///:memory:
TEST_SQL2_URL=sqlite:///:memory:
TEST_NOSQL_URL=mongodb://localhost:27017/tickets_test

# Mock external services en tests
MOCK_EXTERNAL_SERVICES=true

# ===============================
# MONITORING Y OBSERVABILIDAD
# ===============================

# Métricas y tracing (si se implementa)
# METRICS_ENABLED=true
# TRACING_ENABLED=true
# JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Health check intervals
HEALTH_CHECK_INTERVAL_MS=30000

# ===============================
# NOTAS DE CONFIGURACIÓN
# ===============================
#
# 1. BASES DE DATOS:
#    - Configurar 2 motores SQL diferentes + 1 NoSQL
#    - Usar usuarios/passwords específicos por servicio
#    - Configurar connection pooling apropiado
#
# 2. CLOUD PROVIDERS:
#    - Elegir un solo proveedor: AWS, GCP o Azure
#    - Configurar solo las variables del proveedor elegido
#    - Configurar permisos IAM/RBAC apropiados
#
# 3. SEGURIDAD:
#    - Cambiar todas las passwords por defecto
#    - Usar secrets manager en producción
#    - No hardcodear credenciales en código
#
# 4. ESCALABILIDAD:
#    - Configurar límites de conexión de DB
#    - Configurar timeouts apropiados
#    - Implementar circuit breakers si es necesario
#
# 5. MONITOREO:
#    - Configurar logging centralizado
#    - Implementar health checks
#    - Configurar alertas de error rates
#
