# Database Configuration
# MySQL (ms-trips)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=trips_db
MYSQL_USER=trips_user
MYSQL_PASSWORD=secure_password

# PostgreSQL (ms-passengers)  
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=passengers_db
POSTGRES_USER=passengers_user
POSTGRES_PASSWORD=passengers_password

# MongoDB (ms-tickets)
MONGODB_URL=mongodb://tickets_user:tickets_password@localhost:27018/tickets_db?authSource=tickets_db
MONGODB_DB=tickets_db

# Seeding Configuration
TOTAL_RECORDS=20000
BATCH_SIZE=1000
MAX_RETRIES=3

# Data Distribution (must sum to TOTAL_RECORDS)
ROUTES_COUNT=50
PASSENGERS_COUNT=2000
TRIPS_COUNT=3000
TICKETS_COUNT=14950

# Environment
NODE_ENV=development
LOG_LEVEL=info
