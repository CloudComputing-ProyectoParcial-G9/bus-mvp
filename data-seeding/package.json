{
  "name": "bus-mvp-data-seeding",
  "version": "1.0.0",
  "description": "Centralized data seeding for Bus MVP microservices - Generate 20k+ records",
  "main": "seed-all.js",
  "scripts": {
    "seed:all": "node seed-all.js",
    "seed:all:clean": "node seed-all.js --clean",
    "seed:trips": "node seeders/trips-seeder.js",
    "seed:passengers": "node seeders/passengers-seeder.js", 
    "seed:tickets": "node seeders/tickets-seeder.js",
    "seed:history": "node seeders/history-seeder.js",
    "clean:all": "node utils/clean-all.js",
    "stats": "node utils/statistics.js",
    "test:connections": "node utils/test-connections.js",
    "help": "node seed-all.js --help"
  },
  "dependencies": {
    "sequelize": "^6.35.0",
    "mysql2": "^3.6.5",
    "pg": "^8.11.3",
    "mongodb": "^6.3.0",
    "@faker-js/faker": "^8.4.0",
    "dotenv": "^16.3.1",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "seeder",
    "data-generation", 
    "microservices",
    "bus-mvp",
    "mysql",
    "postgresql",
    "mongodb",
    "faker"
