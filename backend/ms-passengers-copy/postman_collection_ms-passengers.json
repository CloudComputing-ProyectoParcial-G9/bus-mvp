{
  "info": {
    "name": "ms-passengers - Bus MVP",
    "_postman_id": "b0f1d8a6-0000-4000-8000-000000000000",
    "description": "Colección para probar los endpoints de ms-passengers (health, create, get, list, update).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "passenger_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List passengers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/passengers?page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "passengers"
          ],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create passenger",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"+1000000000\",\n  \"document_type\": \"DNI\",\n  \"document_number\": \"00000000\",\n  \"date_of_birth\": \"1990-01-01\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/passengers",
          "host": ["{{base_url}}"],
          "path": ["passengers"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Guardar passenger_id en variable de entorno para usar en peticiones siguientes",
              "if (pm.response.code === 201) {",
              "  var json = pm.response.json();",
              "  if (json && json.passenger_id) {",
              "    pm.environment.set('passenger_id', json.passenger_id);",
              "    console.log('passenger_id guardado:', json.passenger_id);",
              "  }",
              "} else {",
              "  console.log('Create passenger returned status:', pm.response.code);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get passenger by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/passengers/{{passenger_id}}",
          "host": ["{{base_url}}"],
          "path": ["passengers", "{{passenger_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "Update passenger",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+15551234567\",\n  \"status\": \"active\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/passengers/{{passenger_id}}",
          "host": ["{{base_url}}"],
          "path": ["passengers", "{{passenger_id}}"]
        }
      },
      "response": []
    }
  ]
}
