{
  "info": {
    "_postman_id": "b5d3f9f2-6c3a-4d2f-9a4e-0a1b2c3d4e5f",
  "name": "ms-tickets - Local",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Colección para probar localmente los endpoints de ms-tickets (Java + Spring Boot + MongoDB). Contiene requests para health, create, list, get, update, cancel y history."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8003",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health - GET /tickets/health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "health"
          ]
        },
        "description": "Comprueba que ms-tickets está vivo. Debe devolver un JSON con status=healthy."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {pm.response.to.have.status(200);});",
              "pm.test('Tiene campo status healthy', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('status');",
              "    pm.expect(json.status).to.eql('healthy');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Ticket - POST /tickets",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passenger_id\": \"passenger-123\",\n  \"trip_id\": \"trip-456\",\n  \"seat_number\": \"12A\",\n  \"payment_method\": \"card\",\n  \"idempotency_key\": \"idem-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets"
          ]
        },
        "description": "Ejemplo de compra de boleto. Ajusta campos según tus datos de prueba. El servicio puede devolver 201 (creado) o 409 (no seats)."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Tiene data.ticket_id', function () {",
              "    pm.expect(json).to.have.property('data');",
              "    pm.expect(json.data).to.have.property('ticket_id');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
    ,
    {
      "name": "List Tickets - GET /tickets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets?page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets"
          ],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Ticket - GET /tickets/:id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/:ticket_id",
          "host": ["{{baseUrl}}"],
          "path": ["tickets", ":ticket_id"]
        }
      },
      "response": []
    },
    {
      "name": "Update Ticket - PUT /tickets/:id",
      "request": {
        "method": "PUT",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "body": {"mode":"raw","raw":"{\n  \"seat_number\": \"12B\",\n  \"booking_status\": \"confirmed\"\n}","options":{"raw":{"language":"json"}}},
        "url": {"raw":"{{baseUrl}}/tickets/:ticket_id","host":["{{baseUrl}}"],"path":["tickets",":ticket_id"]}
      },
      "response": []
    },
    {
      "name": "Cancel Ticket - POST /tickets/:id/cancel",
      "request": {
        "method": "POST",
        "header": [],
        "url": {"raw":"{{baseUrl}}/tickets/:ticket_id/cancel","host":["{{baseUrl}}"],"path":["tickets",":ticket_id","cancel"]}
      },
      "response": []
    },
    {
      "name": "Passenger History - GET /tickets/passenger/:passenger_id/history",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw":"{{baseUrl}}/tickets/passenger/:passenger_id/history","host":["{{baseUrl}}"],"path":["tickets","passenger",":passenger_id","history"]}
      },
      "response": []
    }
  ]
}
