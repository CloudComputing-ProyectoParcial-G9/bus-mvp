	"item": [
		{
			"name": "Health - GET /tickets/health",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200', function () {pm.response.to.have.status(200);});",
							"pm.test('Tiene campo status healthy', function () {",
							"    var json = pm.response.json();",
							"    pm.expect(json).to.have.property('status');",
							"    pm.expect(json.status).to.eql('healthy');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/tickets/health",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"tickets",
						"health"
					]
				},
				"description": "Comprueba que ms-tickets está vivo. Debe devolver un JSON con status=healthy."
			},
			"response": []
		},
		{
			"name": "Create Ticket - POST /tickets",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"var json = pm.response.json();",
							"pm.test('Tiene data.ticket_id', function () {",
							"    pm.expect(json).to.have.property('data');",
							"    pm.expect(json.data).to.have.property('ticket_id');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
