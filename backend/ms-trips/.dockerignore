# ========================================
# .dockerignore - ms-trips
# ========================================
# Archivos y directorios a excluir del contexto de Docker

# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs/
*.log

# Archivos de desarrollo
.env
.env.local
.env.development
.env.test
.env.production

# Base de datos local
data/
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Testing
coverage/
.nyc_output/
test/
tests/
spec/

# Documentación de desarrollo
README.md
QUICK_START.md
docs/
*.md

# Archivos temporales
tmp/
temp/
.tmp/

# Archivos de configuración local
config/local.json
.config/

# Backups
*.backup
*.bak
*.old

# Certificados (por seguridad)
*.pem
*.key
*.cert
*.crt

# Scripts de desarrollo local
quick_start.sh
setup.sh
init.sql
docker-compose.yml